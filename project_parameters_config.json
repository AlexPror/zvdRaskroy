      "unit": "мм",
      "used_in": ["B4 = B1 - B2*2 - 2.5"]
    },
    "коэфф_B5": {
      "name": "4",
      "description": "Вычет для B5 (в формуле B1-4)",
      "value": 4,
      "unit": "мм",
      "used_in": ["B5 = B1 - 4"]
    },
    "коэфф_B6": {
      "name": "60",
      "description": "Вычет для B6 (в формуле B1-60)",
      "value": 60,
      "unit": "мм",
      "used_in": ["B6 = B1 - 60"]
    }
  },
  
  "conditional_variables": {
    "Количество_распорок": {
      "description": "Количество распорок в зависимости от длины",
      "type": "integer",
      "rules": [
        {"condition": "L1 >= 500 and L1 < 1500", "value": 2},
        {"condition": "L1 >= 1500 and L1 < 2000", "value": 3},
        {"condition": "L1 >= 2000 and L1 <= 2400", "value": 4},
        {"condition": "L1 > 2400", "value": 5}
      ],
      "kompas_expression": "if(L1<1500; 2; if(L1<2000; 3; if(L1<=2400; 4; 5)))",
      "used_in": "Массив распорок"
    }
  },
  
  "calculated_variables": {
    "A1": {
      "description": "Рабочая высота (H минус зазор)",
      "formula": "H - A2",
      "depends_on": ["H", "A2"]
    },
    "A": {
      "description": "Рабочая высота (копия A1)",
      "formula": "A1",
      "depends_on": ["A1"]
    },
    "A3": {
      "description": "Высота элемента 3",
      "formula": "A1 - 20",
      "depends_on": ["A1"]
    },
    "A4": {
      "description": "Высота элемента 4",
      "formula": "A1 - 5",
      "depends_on": ["A1"]
    },
    "A5": {
      "description": "Высота элемента 5",
      "formula": "A2 - 1.5",
      "depends_on": ["A2"]
    },
    "B": {
      "description": "Рабочая ширина (копия B1)",
      "formula": "B1",
      "depends_on": ["B1"]
    },
    "B3": {
      "description": "Ширина с учетом двойной толщины стенок",
      "formula": "B1 - B2*2 - 6.9",
      "depends_on": ["B1", "B2"]
    },
    "B4": {
      "description": "Ширина элемента 4",
      "formula": "B1 - B2*2 - 2.5",
      "depends_on": ["B1", "B2"]
    },
    "B5": {
      "description": "Ширина элемента 5",
      "formula": "B1 - 4",
      "depends_on": ["B1"]
    },
    "B6": {
      "description": "Ширина элемента 6",
      "formula": "B1 - 60",
      "depends_on": ["B1"]
    },
    "L": {
      "description": "Рабочая длина (копия L1)",
      "formula": "L1",
      "depends_on": ["L1"]
    }
  },
  
  "calculation_order": [
    "Шаг 1: Входные (H, B1, L1)",
    "Шаг 2: Константы (A2, B2)",
    "Шаг 3: Базовые (A1 = H-A2, A = A1, B = B1, L = L1)",
    "Шаг 4: Производные (A3, A4, A5, B3, B4, B5, B6)"
  ],
  
  "part_variables_mapping": {
    "004 - Корпус короба прямой": {
      "variables": ["A1", "A", "B1", "B", "L1", "L"],
      "description": "Основной корпус - требует все основные параметры"
    },
    "003 - Крышка декоративная": {
      "variables": ["B"],
      "description": "Крышка - зависит только от ширины"
    },
    "005 - Распорка басеейна": {
      "variables": ["A", "B"],
      "description": "Распорка - высота и ширина"
    },
    "006 - Стенка торцевая": {
      "variables": ["A", "B"],
      "description": "Торцевая стенка - высота и ширина"
    },
    "007 - Стенка": {
      "variables": ["B"],
      "description": "Боковая стенка - только ширина"
    }
  }
