      "description": "Длина конвектора",
      "unit": "мм",
      "default": 1400,
      "min": 400,
      "max": 3000,
      "type": "input"
    }
  },
  
  "editable_coefficients": {
    "A2": {
      "description": "Коэффициент высоты (зазор верхний)",
      "unit": "мм",
      "value": 18.5,
      "formula": "фиксированное",
      "used_in": ["A1 = H - A2"]
    },
    "B2": {
      "description": "Коэффициент ширины (толщина стенки)",
      "unit": "мм",
      "value": 18,
      "formula": "фиксированное",
      "used_in": ["B3", "B4"]
    },
    "коэфф_A3": {
      "name": "20",
      "description": "Вычет для A3 (в формуле A1-20)",
      "value": 20,
      "unit": "мм",
      "used_in": ["A3 = A1 - 20"]
    },
    "коэфф_A4": {
      "name": "5",
      "description": "Вычет для A4 (в формуле A1-5)",
      "value": 5,
      "unit": "мм",
      "used_in": ["A4 = A1 - 5"]
    },
    "коэфф_A5": {
      "name": "1.5",
      "description": "Вычет для A5 (в формуле A2-1.5)",
      "value": 1.5,
      "unit": "мм",
      "used_in": ["A5 = A2 - 1.5"]
    },
    "коэфф_B3_1": {
      "name": "6.9",
      "description": "Коррекция для B3 (в формуле B1-B2*2-6.9)",
      "value": 6.9,
      "unit": "мм",
      "used_in": ["B3 = B1 - B2*2 - 6.9"]
    },
    "коэфф_B4_1": {
      "name": "2.5",
      "description": "Коррекция для B4 (в формуле B1-B2*2-2.5)",
